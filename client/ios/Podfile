# Flutter CocoaPods manifest for the SOLO Checker iOS client.
#
# Beyond the standard template this wires the Go engine into the app:
# CI builds the engine as a static c-archive at ios/solo_libs/libsolo.a
# (GOOS=ios GOARCH=arm64, see .github/workflows/ios.yml) and the Runner
# target links it with -force_load so the Solo* exports survive for
# dart:ffi (DynamicLibrary.process() in client/lib/api.dart).
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # ---- Go engine (c-archive) link settings for the Runner app ----
  # -force_load: nothing in native code references SoloInit/SoloCall/…, so a
  #   normal archive link would drop the whole engine as unreferenced. The Go
  #   archive must be pulled in wholesale.
  # -lresolv/-framework: the Go net package uses the system resolver and the
  #   darwin/ios runtime touches CoreFoundation.
  # STRIP_INSTALLED_PRODUCT/DEAD_CODE_STRIPPING off: dart:ffi resolves the
  #   exports with dlsym(RTLD_DEFAULT) at runtime — the symbols have to stay
  #   in the linked binary.
  installer.aggregate_targets.each do |aggregate_target|
    project = aggregate_target.user_project
    project.native_targets.each do |target|
      next unless target.name == 'Runner'
      target.build_configurations.each do |config|
        ldflags = Array(config.build_settings['OTHER_LDFLAGS']).map(&:to_s)
        # $(inherited) keeps whatever the CocoaPods xcconfig contributed.
        ldflags = ['$(inherited)'] if ldflags.empty?
        ldflags << '$(inherited)' unless ldflags.include?('$(inherited)')
        go_archive = '${SRCROOT}/solo_libs/libsolo.a'
        unless ldflags.any? { |f| f.include?('solo_libs/libsolo.a') }
          ldflags << '-Wl,-force_load,' + go_archive
          ldflags << '-lresolv'
          ldflags << '-framework' << 'Foundation'
          ldflags << '-framework' << 'CoreFoundation'
        end
        config.build_settings['OTHER_LDFLAGS'] = ldflags
        config.build_settings['STRIP_INSTALLED_PRODUCT'] = 'NO'
        config.build_settings['DEAD_CODE_STRIPPING'] = 'NO'
      end
    end
    project.save
  end
end
